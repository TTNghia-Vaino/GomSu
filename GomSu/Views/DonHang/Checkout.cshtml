@model dynamic

@{
    ViewData["Title"] = "Thanh Toán";
    var gioHang = ViewBag.GioHang as IEnumerable<GomSu.Models.GioHang>;
    var tongCong = gioHang?.Sum(item => (item.SoLuong ?? 0) * (item.Gia ?? 0)) ?? 0;
}

<h1>Thanh Toán</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-6">
        <h4>Thông tin giao hàng</h4>
        <form asp-action="Checkout" method="post" id="checkoutForm">
            <div class="mb-3">
                <label class="form-label">Địa chỉ giao hàng <span class="text-danger">*</span></label>
                <textarea name="diaChi" class="form-control" rows="3" required placeholder="Nhập địa chỉ giao hàng của bạn"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Phương thức thanh toán <span class="text-danger">*</span></label>
                <div>
                    <input type="radio" name="phuongThucThanhToan" value="1" checked required /> Thanh toán khi nhận hàng (COD)
                </div>
                <div>
                    <input type="radio" name="phuongThucThanhToan" value="2" required /> Chuyển khoản qua mã QR
                </div>
            </div>
            <button type="submit" class="btn btn-success">Xác nhận đặt hàng</button>
        </form>
    </div>
    <div class="col-md-6">
        <h4>Thông tin giỏ hàng</h4>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Sản Phẩm</th>
                    <th>Số Lượng</th>
                    <th>Giá</th>
                    <th>Tổng</th>
                </tr>
            </thead>
            <tbody>
                @if (gioHang != null && gioHang.Any())
                {
                    foreach (var item in gioHang)
                    {
                        <tr>
                            <td>@(item.MaSpNavigation?.TenSp ?? "Unknown Product")</td>
                            <td>@item.SoLuong</td>
                            <td>@string.Format("{0:N0}", item.Gia) VNĐ</td>
                            <td>@string.Format("{0:N0}", (item.SoLuong ?? 0) * (item.Gia ?? 0)) VNĐ</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">Giỏ hàng trống.</td>
                    </tr>
                }
            </tbody>
        </table>
        <h4>Tổng cộng: @string.Format("{0:N0}", tongCong) VNĐ</h4>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('checkoutForm').addEventListener('submit', function (e) {
            var diaChi = document.querySelector('textarea[name="diaChi"]').value.trim();
            var phuongThucThanhToan = document.querySelector('input[name="phuongThucThanhToan"]:checked');

            if (!diaChi) {
                e.preventDefault();
                alert('Vui lòng nhập địa chỉ giao hàng.');
                return;
            }
            if (!phuongThucThanhToan) {
                e.preventDefault();
                alert('Vui lòng chọn phương thức thanh toán.');
                return;
            }
        });
    </script>
}