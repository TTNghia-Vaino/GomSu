@{
    ViewData["Title"] = "Xác Nhận Thanh Toán";
}

<div class="container mt-5">
    <div class="card shadow-sm p-4 text-center">
        <h1 class="mb-4 text-success">Thanh Toán Thành Công!</h1>
        <p>Đơn hàng của bạn đã được ghi nhận.</p>
        <p><strong>Mã đơn hàng:</strong> #@ViewBag.MaDonHang</p>
        <p><strong>Địa chỉ giao hàng:</strong> @(ViewBag.DiaChi ?? "Không có thông tin")</p>
        <p><strong>Số tiền thanh toán:</strong> @(ViewBag.TongTien != null ? string.Format("{0:N0}", ViewBag.TongTien) : "0") VNĐ</p>
        <p class="text-muted">Trạng thái hiện tại: <strong>Chờ duyệt</strong>. Vui lòng chờ xác nhận từ chúng tôi.</p>
        <p>Chúng tôi sẽ liên hệ với bạn qua email hoặc số điện thoại đã cung cấp.</p>
        <a href="@Url.Action("Index", "SanPham")" class="btn btn-primary mt-4">Quay lại trang chủ</a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}