<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin GomSu</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 bg-dark text-white p-0" style="min-height: 100vh;">
                <div class="p-3 text-center">
                    <h4>GomSu Admin</h4>
                </div>
                <div class="list-group list-group-flush">
                    <a href="/Admin/Home" class="list-group-item list-group-item-action bg-dark text-white">
                        <i class="fas fa-tachometer-alt me-2"></i> Dashboard
                    </a>
                    <a href="/Admin/SanPham" class="list-group-item list-group-item-action bg-dark text-white">
                        <i class="fas fa-box me-2"></i> Sản phẩm
                    </a>
                    <a href="/Admin/DonHang" class="list-group-item list-group-item-action bg-dark text-white">
                        <i class="fas fa-shopping-cart me-2"></i> Đơn hàng
                    </a>
                    <a href="/Admin/TaiKhoan" class="list-group-item list-group-item-action bg-dark text-white">
                        <i class="fas fa-users me-2"></i> Tài khoản
                    </a>
                    <a href="/Admin/LoaiSanPham" class="list-group-item list-group-item-action bg-dark text-white">
                        <i class="fas fa-tags me-2"></i> Loại sản phẩm
                    </a>
                    <a href="/" class="list-group-item list-group-item-action bg-dark text-white">
                        <i class="fas fa-home me-2"></i> Về trang chủ
                    </a>
                </div>
            </div>
            
            <!-- Main content -->
            <div class="col-md-10 p-4">
                <div class="pb-2 mb-4 border-bottom">
                    <h2>@ViewData["Title"]</h2>
                </div>
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>